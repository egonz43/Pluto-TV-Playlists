0&q=75&w=960"},"clip":{"actors":["John Krasinski","Pablo Schreiber","James Badge Dale"],"directors":["Michael Bay"],"writers":["Chuck Hogan"],"producers":["Erwin Stoff","Michael Bay"],"originalReleaseDate":"2016-01-15T00:00:00Z"},"avail":{},"ad":true,"cc":true,"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/635ac72c3416c70013de7eee/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=e8a342a4-228f-4f79-995a-47dcf5adcda7&clientModelNumber=1.0.0&country=US&deviceDNT=false&deviceId=e8a342a4-228f-4f79-995a-47dcf5adcda7&deviceLat=33.9000&deviceLon=-117.9100&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=US&serverSideAds=true&sessionID=b77140be-c7d1-11f1-8fdc-3ac3986404f6&sid=b77140be-c7d1-11f1-8fdc-3ac3986404f6&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6ImQ0ODJmOGViLTczMjgtNDIxMi1iMmNjLTZmYTE0NGJiZTQ1OCIsInR5cCI6IkpXVCJ9..ABs-pAekwp0XIwARSzl7Ap3PHixXiyVYq2Ca5o_4WEw&masterJWTPassthrough=true"},"5d38b6e9339218ad22bcd275-us":{"_id":"5d38b6e9339218ad22bcd275","seriesID":"5d38b6e9339218ad22bcd271","slug":"fat-man-and-little-boy-paramount-1-1","name":"Fat Man and Little Boy","summary":"In the remote desert of New Mexico, “The Manhattan Project” is materializing – the World War II effort to build the atomic bomb.","description":"In the remote desert of New Mexico, \"The Manhattan Project\" is materializing the World War II effort to build the atomic bomb. Oscar-winner Paul Newman (Hud, Nobody's Fool) stars as General Leslie Groves, the military man in charge of a massive project that will produce two weapons: \"Fat Man\" and \"Little Boy.\" Dwight Schultz (The Temp, Star Trek: First Contact) is J. Robert Oppenheimer, the brilliant scientist attempting to bring the startling mission to fruition. And Bonnie Bedelia, John Cusack, Laura Dern, and Natasha Richardson co-star in this \"stunning, profoundly moving\" film (Michael Medved, Sneak Previews) that re-creates one of history's most compelling chapters; one that resulted in the mushroom-shaped specter that changed the world forever.","duration":9900000,"originalContentDuration":7605000,"allotment":9900,"rating":"PG-13","featuredImage":{"path":"https://images.pluto.tv/episodes/5d38b6e9339218ad22bcd275/screenshot16_9_1791470532536.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5d38b6e9339218ad22bcd275/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5d38b6e9339218ad22bcd275/poster_1791470532536.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5d38b6e9339218ad22bcd275/screenshot4_3_1791470532536.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5d38b6e9339218ad22bcd275/screenshot16_9_1791470532536.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"58c49d9d250dc501634e63d4"},{"id":"5bbe4765ae57925cf9c608d5"},{"id":"636d58a1531e0c000743cb48"},{"id":"67ae1ec3fcecda97eb885ada"},{"id":"5ec2ce0b8524d80007a8288d"},{"id":"6a2b2398f5a1bedf7ba54178"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5d38b6e9339218ad22bcd275/poster16_9_1791470532536.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Paul Newman","Dwight Schultz","Bonnie Bedelia","John Cusack","Laura Dern","Ron Frazier","John C. McGinley","Natasha Richardson","Ron Vawter","Roger Cubicciotti"],"directors":["Roland Joffe"],"writers":["Bruce Robinson","Roland Joff"],"producers":["Tony Garnett","John Calley"],"originalReleaseDate":"1989-01-01T00:00:00Z"},"avail":{},"cc":true,"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5d38b6e9339218ad22bcd275/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb