re to hunt for him.","duration":8100000,"originalContentDuration":5970000,"allotment":8100,"rating":"TV-14","featuredImage":{"path":"https://images.pluto.tv/episodes/69a6383127ed3c42e374908c/screenshot16_9_1772661241514.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Action & Adventure","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69a6383127ed3c42e374908c/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69a6383127ed3c42e374908c/poster_1772661241514.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69a6383127ed3c42e374908c/screenshot4_3_1772661241514.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69a6383127ed3c42e374908c/screenshot16_9_1772661241514.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"606ce03604440700077fb5de"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69a6383127ed3c42e374908c/poster16_9_1772661241514.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Sonja Gerhardt","Milam Farooq","Tim Oliver Schultz"],"directors":["Michael David Pate"],"producers":["Till Schmerbeck"],"originalReleaseDate":"2019-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69a6383127ed3c42e374908c/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=e8a342a4-228f-4f79-995a-47dcf5adcda7&clientModelNumber=1.0.0&country=US&deviceDNT=false&deviceId=e8a342a4-228f-4f79-995a-47dcf5adcda7&deviceLat=33.9000&deviceLon=-117.9100&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=US&serverSideAds=true&sessionID=b77140be-c7d1-11f1-8fdc-3ac3986404f6&sid=b77140be-c7d1-11f1-8fdc-3ac3986404f6&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6ImQ0ODJmOGViLTczMjgtND