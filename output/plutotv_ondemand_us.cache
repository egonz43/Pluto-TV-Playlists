fa69741a697001a15ae7e/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Neve Campbell","Bette Midler","Danny DeVito"],"directors":["Nick Gomez"],"writers":["Peter Steinfeld"],"producers":["Bart Rosenblatt","Eugene Musso","Al Corley"],"originalReleaseDate":"2000-03-03T00:00:00Z"},"avail":{},"cc":true,"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5f7fa69741a697001a15ae7e/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=e8a342a4-228f-4f79-995a-47dcf5adcda7&clientModelNumber=1.0.0&country=US&deviceDNT=false&deviceId=e8a342a4-228f-4f79-995a-47dcf5adcda7&deviceLat=33.9000&deviceLon=-117.9100&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=US&serverSideAds=true&sessionID=b77140be-c7d1-11f1-8fdc-3ac3986404f6&sid=b77140be-c7d1-11f1-8fdc-3ac3986404f6&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6ImQ0ODJmOGViLTczMjgtNDIxMi1iMmNjLTZmYTE0NGJiZTQ1OCIsInR5cCI6IkpXVCJ9..ABs-pAekwp0XIwARSzl7Ap3PHixXiyVYq2Ca5o_4WEw&masterJWTPassthrough=true"},"5bbcdc66af4ce1bd7613fcd5-us":{"_id":"5bbcdc66af4ce1bd7613fcd5","seriesID":"5bbcdc66af4ce1bd7613fccf","slug":"son-of-rambow-2008-1-1","name":"Son of Rambow","summary":"A hilariously fresh take on friendship, family, film heroes and the death-defying adventures of growing up in the video age.","description":"Imagination, fantasy, and the irreplaceable bonds of childhood friendship highlight this “comedy that’s full of heart” (Joe Neumaier, NY Daily News). Will Proudfoot (Bill Milner) is looking for an escape from his family’s stifling home life when he encounters Lee Carter (Will Poulter), the school bully. Armed with a video camera and a copy of Rambo: First Blood, Lee plans to make cinematic history by filming his own action-packed video epic. Together, these two newfound friends-turned-budding-filmmakers quickly discover that their imaginative – and sometimes mishap-filled – cinematic adventure has begun to take on a life of its own! Entertaining, uplifting, and brimming with nostalgia, Son of Rambow “makes you feel like a kid again” (Ethan Alter, Giant Magazine).","duration":7200000,"originalContentDuration":5745000,"allotment":7200,"rating":"PG-13","featuredImage":{"path":"https://images.pluto.tv/episodes/5bbcdc66af4ce1bd7613fcd5/screenshot16_9_1767951725772.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5bbcdc66af4ce1bd7613fcd5/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5bbcdc66af4ce1bd7613fcd5/poster_1767951725772.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5bbcdc66af4ce1bd7613fcd5/screenshot4_3_1767951725772.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5bbcdc66af4ce1bd7613fcd5/screenshot16_9_1767951725772.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"58c34fd4250dc501634e608b"},{"id":"629fc5c5021d970007386ff8"},{"id":"5e73b97051ff0700072157db"},{"id":"6787f3ba5e0e6a00083052b3"},{"id":"67ae6d1238ca8e2548ce58d9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5bbcdc66af4ce1bd7613fcd5/poster16_9_1767951725772.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Anna Wing","Bill Milner","Ed Westwick","Eric Sykes","Jessica Stevenson","Jules Sitruk","Neil Dudgeon","Will Poulter"],"directors":["Garth Jennings"],"originalReleaseDate":"2008-01-01T00:00:00Z"},"avail":{},"cc":true,"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5bbcdc66af4ce1bd7613fcd5/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=e8a342a4-228f-4f79-995a-47dcf5adcda7&clientModelNumber=1.0.0&coun