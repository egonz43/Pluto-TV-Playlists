ce-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5daa49c74d8bff9cc171c7a8/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=e8a342a4-228f-4f79-995a-47dcf5adcda7&clientModelNumber=1.0.0&country=US&deviceDNT=false&deviceId=e8a342a4-228f-4f79-995a-47dcf5adcda7&deviceLat=33.9000&deviceLon=-117.9100&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=US&serverSideAds=true&sessionID=b77140be-c7d1-11f1-8fdc-3ac3986404f6&sid=b77140be-c7d1-11f1-8fdc-3ac3986404f6&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6ImQ0ODJmOGViLTczMjgtNDIxMi1iMmNjLTZmYTE0NGJiZTQ1OCIsInR5cCI6IkpXVCJ9..ABs-pAekwp0XIwARSzl7Ap3PHixXiyVYq2Ca5o_4WEw&masterJWTPassthrough=true"},"564d1f284856cf8c37a9ae7a-us":{"_id":"564d1f284856cf8c37a9ae7a","seriesID":"564d1119c853b0790514fc4e","slug":"the-terror-1-1","name":"The Terror","summary":"A young officer in Napoleon's army pursues a mysterious woman to the castle of an elderly Baron.","description":"The ghostly apparition of a young woman is witnessed by an 18th Century French Lieutenant in Napoleon’s army. After two failed attempts to keep up with her, Lt. Andre Duvalier (Nicholson) heads to the castle of Baron Von Leppe (Karloff), where he notices a painting of the Baron’s late wife Ilsa, who looks identical to the ghostly woman. Duvalier is now determined to unravel the castle’s mystery, and the Baron’s hidden secrets. Though officially credited to Roger Corman, The Terror had a total of five collaborative Directors, including Nicholson himself, and Francis Ford Coppola.","duration":6300000,"originalContentDuration":4770000,"allotment":6300,"rating":"TV-PG","featuredImage":{"path":"https://images.pluto.tv/episodes/564d1f284856cf8c37a9ae7a/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Horror","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/564d1f284856cf8c37a9ae7a/master.m3u8"},"co